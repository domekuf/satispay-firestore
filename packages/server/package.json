{
  "name": "@muvat/server",
  "version": "1.0.0",
  "description": "Satispay payment gateway with Firestore persistence",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --require dotenv/config dist/index.js",
    "dev": "node --watch --watch-path=. --watch-preserve-output --require dotenv/config --require ts-node/register index.ts",
    "dev:watch": "node --watch --watch-path=. --watch-preserve-output --require dotenv/config --require ts-node/register index.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "@muvat/shared": "workspace:*",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
